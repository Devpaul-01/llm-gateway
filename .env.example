# =============================================================================
# llm-gateway configuration. Copy to .env (git-ignored) and fill in.
# Required variables are marked REQUIRED; everything else has a default.
# =============================================================================

# --- Core (REQUIRED) ----------------------------------------------------------

# Postgres connection string. Supabase: use the pooler URL (Project Settings ->
# Database -> Connection pooling). Local docker-compose: see docker-compose.yml.
DATABASE_URL=postgres://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Redis connection string. Used for rate limits, budgets, concurrency slots,
# credential cooldowns, circuit breakers, auth/settings caches and the
# response cache. Use rediss:// for TLS (e.g. Upstash).
REDIS_URL=redis://localhost:6379/0

# 32-byte AES-256 key, hex encoded (64 hex chars). Encrypts provider API keys at
# rest. Generate one with:  go run ./cmd/genkey
# WARNING: losing or changing this makes every stored provider key unreadable.
ENCRYPTION_KEY=

# Bearer token for the /admin/* endpoints. Use a long random value:
#   openssl rand -hex 32
ADMIN_TOKEN=

# --- Server -------------------------------------------------------------------

# Port to listen on.
PORT=8080

# Apply pending SQL migrations (internal/db/migrations) on startup. Safe to
# leave on: it is idempotent, takes an advisory lock so several instances can
# boot together, and baselines databases created by hand from 000001.
AUTO_MIGRATE=true

# --- Per-project defaults -----------------------------------------------------
# Used when a project has no override. Override per project with
#   PATCH /admin/projects/{id}  {"rate_limit_per_min": 120}

# Requests per minute per gateway key.
DEFAULT_RATE_LIMIT_PER_MIN=60
# Simultaneous in-flight requests per project.
DEFAULT_MAX_CONCURRENT_STREAMS=10
# Tokens (prompt + completion) per project per UTC day.
DEFAULT_TOKEN_BUDGET=100000

# --- Response cache -----------------------------------------------------------
# Exact-match cache for requests that set "temperature": 0. Sampled requests are
# never cached. Clients can opt out per request with "cache": false or a
# "Cache-Control: no-cache" header; flush a project with
#   DELETE /admin/projects/{id}/cache

CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- Public metrics (portfolio / status page) ---------------------------------
# GET /public/metrics?window=1h|6h|24h|7d returns aggregate, read-only stats with
# no keys, prompts, or ids in them. Disabled by default.

PUBLIC_METRICS_ENABLED=false
# Limit the public numbers to one project (its id). Empty = all projects.
PUBLIC_METRICS_PROJECT_ID=
# Browser origins allowed to call /public/* (comma separated, or *).
# Example: https://your-portfolio.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- Provider overrides (optional) --------------------------------------------
# Provider API keys are NOT configured here: add them per project through
#   POST /admin/credentials {"project_id": "...", "provider": "groq", "api_key": "..."}
# Supported providers: groq, mistral, openrouter, gemini, openai, deepseek,
# together, fireworks, cerebras, xai, deepinfra, sambanova
# (list them with GET /admin/providers).
#
# Point a provider at a different OpenAI-compatible endpoint (a proxy, a mock,
# a regional URL). Pattern: PROVIDER_<NAME>_BASE_URL
# PROVIDER_GROQ_BASE_URL=http://localhost:9001/v1
#
# Force stream_options.include_usage on/off for a provider (true/false). The
# built-in defaults already match each provider's behaviour.
# PROVIDER_GROQ_STREAM_USAGE=false

# --- Live integration tests (optional) ----------------------------------------
# `go test ./...` skips these unless the key is set.
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
